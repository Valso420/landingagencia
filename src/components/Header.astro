---
import { Image } from 'astro:assets';
import windowImage from '../assets/airplane-window.png';
import { agency } from '../config/agency';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const links = [
  { title: 'Inicio', href: '/#inicio' },
  { title: 'La agencia', href: '/agencia/' },
  { title: 'Destinos', href: '/destinos/' },
  { title: 'Contacto', href: '/contacto/' },
];
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="header-inner">
    <a class="agency-name" href="/">{agency.name}</a>
    <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-menu" hidden>
      <img class="menu-open-icon" src="/menu.svg" width="24" height="24" alt="" />
      <img class="menu-close-icon" src="/close.svg" width="24" height="24" alt="" />
    </button>
  </div>
  <nav id="main-menu" class="main-menu" aria-label="Navegación principal">
    <div class="menu-backdrop" data-window-scene data-phase="dia" aria-hidden="true">
      <img class="menu-photo" alt="" hidden />
      <div class="menu-window">
        <Image class="window-photo" src={windowImage} alt="" widths={[512, 768, 1024]} sizes="(min-width: 800px) 660px, 124vw" format="webp" quality={88} loading="eager" fetchpriority="low" />
        <div class="window-light window-light--night"></div>
        <div class="window-light window-light--dawn"></div>
        <div class="window-light window-light--warm"></div>
      </div>
    </div>
    <div class="menu-inner">
      <p class="menu-brand">{agency.name}</p>
      <ol>
        {links.map(link => <li><a href={link.href}>{link.title}</a></li>)}
      </ol>
      <a class="button menu-social" href={agency.contact.instagram ?? '/contacto/'} target={agency.contact.instagram ? '_blank' : undefined} rel={agency.contact.instagram ? 'noopener noreferrer' : undefined}>Instagram</a>
    </div>
  </nav>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('.main-menu');
  if (header && toggle && nav) {
    toggle.hidden = false;
    nav.hidden = true;
    header.classList.add('menu-enhanced');
    const themedFrames = [...document.querySelectorAll<HTMLElement>('[data-header-theme]')];
    let themeUpdate = 0;
    const updateTheme = () => {
      themeUpdate = 0;
      const sampleY = header.getBoundingClientRect().height / 2;
      const frame = themedFrames.find(element => {
        if (element.classList.contains('frame-outgoing')) return false;
        const bounds = element.getBoundingClientRect();
        return bounds.top <= sampleY && bounds.bottom > sampleY;
      });
      header.dataset.theme = frame?.dataset.headerTheme ?? 'light';
    };
    const scheduleTheme = () => {
      if (!themeUpdate) themeUpdate = requestAnimationFrame(updateTheme);
    };
    window.addEventListener('scroll', scheduleTheme, { passive: true });
    window.addEventListener('framechange', updateTheme);
    window.addEventListener('resize', scheduleTheme);
    window.addEventListener('pageshow', scheduleTheme);
    document.fonts.ready.then(scheduleTheme);
    updateTheme();
    const main = document.querySelector('main');
    const photo = nav.querySelector<HTMLImageElement>('.menu-photo')!;
    const windowBackdrop = nav.querySelector<HTMLElement>('.menu-window')!;
    const frames = [...document.querySelectorAll<HTMLElement>('.screen-frame')];
    const updateBackdrop = () => {
      const frame = frames.find(element => {
        if (element.classList.contains('frame-outgoing')) return false;
        const bounds = element.getBoundingClientRect();
        return bounds.top <= innerHeight / 2 && bounds.bottom > innerHeight / 2;
      });
      const source = frame?.querySelector<HTMLImageElement>('[data-menu-background]');
      photo.hidden = !source;
      windowBackdrop.hidden = Boolean(source);
      if (!source) return;
      const bounds = source.getBoundingClientRect();
      const style = getComputedStyle(source);
      photo.src = source.currentSrc || source.src;
      Object.assign(photo.style, {
        left: `${bounds.left}px`, top: `${bounds.top}px`,
        width: `${bounds.width}px`, height: `${bounds.height}px`,
        objectFit: style.objectFit, objectPosition: style.objectPosition,
      });
    };
    window.addEventListener('resize', () => { if (!nav.hidden) updateBackdrop(); });
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const surfaces = [nav, ...nav.querySelectorAll<HTMLElement>('.menu-brand, li, .menu-social')];
    let isOpen = false;
    let revision = 0;
    let effects: Animation[] = [];
    const settle = () => {
      nav.hidden = !isOpen;
      nav.inert = !isOpen;
      header.classList.toggle('is-open', isOpen);
      document.body.classList.toggle('menu-is-open', isOpen);
      if (main) main.inert = isOpen;
      effects.forEach(effect => effect.cancel());
      effects = [];
    };
    const setOpen = (open: boolean, returnFocus = false, animate = true) => {
      if (open === isOpen && animate) return;
      const wasHidden = nav.hidden;
      const opacity = surfaces.map(element => wasHidden ? 0 : Number(getComputedStyle(element).opacity));
      const currentRevision = ++revision;
      effects.forEach(effect => effect.cancel());
      effects = [];
      isOpen = open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      if (open) {
        if (wasHidden) updateBackdrop();
        nav.hidden = false;
        nav.inert = false;
        header.classList.add('is-open');
        document.body.classList.add('menu-is-open');
        if (main) main.inert = true;
        if (wasHidden) nav.scrollTop = 0;
        nav.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      } else {
        if (returnFocus || nav.contains(document.activeElement)) toggle.focus({ preventScroll: true });
        nav.inert = true;
      }
      if (!animate || reducedMotion.matches) { settle(); return; }
      const backgroundDuration = 260 * Math.abs(Number(open) - opacity[0]);
      const contentExitDuration = opacity.slice(1).some(value => value > 0) ? 180 : 0;
      // Keep the background opaque while menu text is visible, including on reversal.
      effects = surfaces.map((element, index) => element.animate([
        { opacity: opacity[index] },
        { opacity: open ? 1 : 0 },
      ], {
        duration: index === 0 ? backgroundDuration : open ? 240 : contentExitDuration,
        delay: index === 0
          ? open ? 0 : contentExitDuration
          : open ? backgroundDuration + (wasHidden ? (index - 1) * 20 : 0) : 0,
        easing: 'ease-in-out',
        fill: 'both',
      }));
      void Promise.all(effects.map(effect => effect.finished)).then(() => {
        if (revision === currentRevision) settle();
      }, () => { /* Reversing the menu cancels the previous animation. */ });
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (event) => {
      // Release scroll and focus immediately for native links, including same-page anchors.
      if ((event.target as Element).closest('a')) setOpen(false, true, false);
    });
    reducedMotion.addEventListener('change', () => { if (reducedMotion.matches) { revision++; settle(); } });
    window.addEventListener('pagehide', () => setOpen(false, false, false));
    header.addEventListener('keydown', (event) => {
      if (nav.hidden) return;
      if (event.key === 'Escape') { event.preventDefault(); setOpen(false, true); }
      if (event.key !== 'Tab') return;
      if (!isOpen) { event.preventDefault(); toggle.focus({ preventScroll: true }); return; }
      const focusable = [toggle, ...nav.querySelectorAll<HTMLAnchorElement>('a[href]')];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
  }
</script>
