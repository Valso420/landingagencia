---
import { Image } from 'astro:assets';
import plusIcon from '../assets/destination-plus.svg';
import { destinations, regions } from '../data/destinations';
import '../styles/destinations.css';

interface Props { standalone?: boolean }
const { standalone = false } = Astro.props;
---

<section id="destinos" class:list={['destination-explorer', { 'destination-explorer--standalone': standalone }]} aria-label="Explorá nuestros destinos" data-destination-explorer>
  <p class="sr-only" id="destination-carousel-help">Deslizá horizontalmente o elegí un país debajo de la tarjeta para cambiar de destino. También podés usar las flechas izquierda y derecha con el foco en las tarjetas o en el selector.</p>
  {regions.map((region, index) => {
    const Heading = standalone && index === 0 ? 'h1' : 'h2';
    const items = region.destinationSlugs.map(slug => destinations.find(destination => destination.slug === slug)!);
    return (
      <article id={`region-${region.slug}`} class={`screen-frame region-panel region-panel--${region.slug}`} data-region={region.slug} data-frame-stop={!standalone && index === 0 ? '' : undefined} aria-labelledby={`region-title-${region.slug}`}>
        {items.map((destination, destinationIndex) => (
          <Image src={destination.image} alt="" class="region-background" data-destination-background={destination.slug} data-menu-background={destinationIndex === 0 ? '' : undefined} hidden={destinationIndex !== 0} quality={90} loading={standalone && index === 0 && destinationIndex === 0 ? 'eager' : 'lazy'} />
        ))}
        <div class="region-content">
          <Heading id={`region-title-${region.slug}`} class="region-title" tabindex="-1">{region.name}</Heading>
          <div class="destination-deck" data-destination-deck>
            <ul id={`destination-cards-${region.slug}`} class="destination-cards" aria-label={`Recorridos ilustrativos de ${region.name}`} aria-describedby="destination-carousel-help" tabindex="0">
              {items.map(destination => (
                <li class="destination-card-item" data-destination-name={destination.name}>
                  <a class="destination-card" href={`/destinos/${destination.slug}/`} aria-label={`Ver ficha de ${destination.name}: ${destination.route}`}>
                    <Image src={destination.image} alt={destination.imageAlt} widths={[552, 828]} sizes="(min-width: 760px) 640px, 552px" quality={90} loading="lazy" />
                    <div class="destination-card-copy">
                      <h3>{destination.cardTitle}</h3>
                      <p>{destination.cardRoute}</p>
                    </div>
                    <span class="destination-card-action" aria-hidden="true"><img src={plusIcon.src} width="24" height="24" alt="" /></span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="destination-controls" role="group" aria-label={`Elegir destino en ${region.name}`} hidden>
              {items.map((destination, destinationIndex) => (
                <button type="button" class="destination-choice" aria-label={`Mostrar ${destination.name}`} aria-controls={`destination-cards-${region.slug}`} aria-pressed={destinationIndex === 0 ? 'true' : 'false'}>{destination.name}</button>
              ))}
              <p class="destination-position sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
            </div>
          </div>
          <p class="region-description">{region.description}</p>
        </div>
      </article>
    );
  })}
</section>

<script>
  import '../scripts/destination-cards';

  const explorer = document.querySelector<HTMLElement>('[data-destination-explorer]');

  if (explorer) {
    const restoreRegion = () => {
      const regionHash = location.hash.startsWith('#region-');
      if (location.hash && location.hash !== '#destinos' && !regionHash) return;
      const slug = regionHash ? location.hash.slice(8) : new URLSearchParams(location.search).get('region');
      if (!slug) return;
      const panel = [...explorer.querySelectorAll<HTMLElement>('[data-region]')].find(item => item.dataset.region === slug);
      if (!panel) return;
      // Normalize legacy links so the browser's fragment scroll targets the same region.
      if (location.hash !== `#${panel.id}`) {
        const url = new URL(location.href);
        url.hash = panel.id;
        history.replaceState(null, '', url);
      }
      panel.scrollIntoView({ block: 'start', behavior: 'instant' });
    };

    restoreRegion();
    window.addEventListener('load', restoreRegion, { once: true });
    document.fonts.ready.then(restoreRegion);
    window.addEventListener('popstate', restoreRegion);
    window.addEventListener('hashchange', restoreRegion);
  }
</script>
