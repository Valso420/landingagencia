---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinationExplorer from '../../components/DestinationExplorer.astro';
import { agency } from '../../config/agency';
---

<BaseLayout title={`Destinos · ${agency.name}`} description="Explorá propuestas ilustrativas de viaje por Asia, Europa y América." overlayHeader={true}>
  <DestinationExplorer standalone />
  <section class="destinations-contact" aria-labelledby="destinations-contact-title">
    <div>
      <h2 id="destinations-contact-title">¿Qué destino te interesa?</h2>
      <a class="destinations-contact-link" href="/contacto/">Consultar destinos</a>
    </div>
  </section>
</BaseLayout>
