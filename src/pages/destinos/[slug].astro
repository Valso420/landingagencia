---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import backIcon from '../../assets/destination-back.svg';
import { destinations, regions, type Destination } from '../../data/destinations';
import '../../styles/destinations.css';

export function getStaticPaths() {
  return destinations.map((destination) => ({
    params: { slug: destination.slug },
    props: { destination },
  }));
}

interface Props { destination: Destination }
const { destination } = Astro.props;
const returnUrl = `/?region=${destination.region}#destinos`;
const region = regions.find(item => item.slug === destination.region)!;
const contactUrl = `/contacto/?destino=${destination.slug}`;
---

<BaseLayout title={`${destination.name} · Recorrido ilustrativo`} description={destination.description} overlayHeader>
  <section class:list={['screen-frame', 'destination-cover', `destination-cover--${destination.slug}`]} aria-labelledby="destination-name" data-header-theme="light">
    <Image src={destination.image} alt={destination.imageAlt} class="destination-cover-image" data-menu-background quality={90} loading="eager" fetchpriority="high" />
    <a class="destination-back" href={returnUrl} aria-label={`Volver a destinos de ${region.name}`}><img src={backIcon.src} width="24" height="24" alt="" /></a>
    <div class="destination-cover-title">
      <h1 id="destination-name">{destination.name}</h1>
      <p>{destination.route}</p>
    </div>
    <div class="destination-summary">
      <h2>{destination.headline}</h2>
      <p>{destination.description}</p>
      <small>Recorrido ilustrativo</small>
      <a class="destination-itinerary-link" href={contactUrl}>Consultar</a>
    </div>
  </section>

  <div id="recorrido" class="screen-frame destination-details" data-header-theme="dark">
    <section class="destination-stops" aria-labelledby="stops-title">
      <div class="destination-stops-inner">
        <h2 id="stops-title">Paradas del viaje</h2>
        <ol>
          {destination.stops.map((stop, index) => (
            <li>
              <span class="stop-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{stop.city}</h3>
                <p class="stop-area">{stop.area}</p>
                <p class="stop-description">{stop.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="destination-consult" aria-labelledby="consult-title">
      <div>
        <h2 id="consult-title">Consultas sobre {destination.name}</h2>
        <p>Escribinos para conversar sobre destinos y posibles recorridos.</p>
        <a class="destination-consult-link" href={contactUrl}>Consultar</a>
        <a class="destination-region-return" href={returnUrl}>Volver a {region.name} <span aria-hidden="true">↑</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
