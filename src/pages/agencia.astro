---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import planning from '../assets/travel-planning.jpg';
import cinqueTerre from '../assets/cinque-terre.png';
import { agency } from '../config/agency';
---
<BaseLayout title={`La agencia · ${agency.name}`}>
  <article class="agency-page">
    <div class="agency-content">
      <h1>Quiénes<br />somos</h1>
      <Image class="agency-planning" src={planning} alt="Mapa y cámara fotográfica preparados para planificar un viaje" widths={[400, 700, 1100]} sizes="(min-width: 900px) 520px, calc(100vw - 48px)" format="webp" loading="eager" />
      <section class="agency-introduction" aria-labelledby="agency-introduction-title">
        <h2 id="agency-introduction-title">Una agencia virtual.<br />Varios destinos<br />en un mismo viaje.</h2>
        <p>Nos enfocamos en viajes al exterior y propuestas multidestino. El recorrido se piensa como un conjunto: los lugares que querés conocer, el tiempo que tenés y la forma en la que te gusta viajar.</p>
      </section>
      <section class="agency-approach" aria-labelledby="agency-approach-title">
        <Image class="agency-landscape" src={cinqueTerre} alt="Pueblo de Manarola, en Cinque Terre, junto al mar" widths={[400, 700, 1000]} sizes="(min-width: 900px) 520px, calc(100vw - 48px)" format="webp" loading="lazy" />
        <h2 id="agency-approach-title">Cómo pensamos<br />cada recorrido</h2>
        <p>{agency.mission}</p>
      </section>
      <section class="agency-team" aria-labelledby="agency-team-title">
        <h2 id="agency-team-title">Detrás de la agencia</h2>
        <p>{agency.history}</p>
      </section>
      <div class="agency-continuation">
        <a class="button button--dark" href="/destinos/">Explorar destinos</a>
        <p>Texto provisional para revisar con la agencia.</p>
      </div>
    </div>
  </article>
</BaseLayout>
<style>
  .agency-page { background: var(--paper); }
  .agency-content { padding: 36px 24px 44px; max-width: 630px; margin: auto; display: flex; flex-direction: column; gap: 24px; }
  h1 { font-family: 'Montserrat',sans-serif; font-size: 45px; line-height: 1.02; font-weight: 700; letter-spacing: -1.35px; text-transform: uppercase; }
  .agency-planning { width: 100%; aspect-ratio: 342/280; object-fit: cover; filter: grayscale(1); }
  section { display: flex; flex-direction: column; gap: 18px; }
  h2 { font-family: 'Montserrat',sans-serif; font-size: 27px; font-weight: 500; line-height: 1.43; letter-spacing: 0; }
  p { font-size: 16px; line-height: 1.43; }
  .agency-landscape { width: 100%; aspect-ratio: 342/200; object-fit: cover; }
  .agency-approach h2 { font-size: 31px; letter-spacing: -.93px; }
  .agency-team { padding-top: 22px; gap: 16px; }
  .agency-team h2 { font-size: 29px; }
  .agency-team p { font-size: 15px; color: var(--muted); }
  .agency-continuation { display: flex; flex-direction: column; gap: 18px; padding-top: 18px; }
  .agency-continuation .button { width: 100%; }
  .agency-continuation p { font-size: 12px; color: var(--muted); }
  @media(min-width:900px) {
    .agency-content { max-width: 1200px; padding: 64px 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px 64px; align-items: start; }
    h1 { grid-column: 1/-1; font-size: 64px; }
    .agency-planning { grid-column: 1; grid-row: 2; }
    .agency-introduction { grid-column: 2; grid-row: 2; align-self: center; }
    .agency-approach { grid-column: 1; }
    .agency-team { grid-column: 2; }
    .agency-continuation { grid-column: 2; align-self: start; }
  }
</style>
