---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import planning from '../assets/travel-planning.jpg';
import cinqueTerre from '../assets/cinque-terre.png';
import { agency } from '../config/agency';
---
<BaseLayout title={`La agencia · ${agency.name}`}>
  <article class="agency-page">
    <section class="agency-frame screen-frame" aria-labelledby="agency-title" data-header-theme="dark" data-frame-scroll="native">
      <div class="agency-content agency-intro-content">
        <h1 id="agency-title">Quiénes<br />somos</h1>
        <Image class="agency-planning" src={planning} alt="Mapa y cámara fotográfica preparados para planificar un viaje" widths={[400, 700, 1100]} sizes="(min-width: 900px) 520px, calc(100vw - 48px)" format="webp" loading="eager" />
        <div class="agency-introduction">
          <h2>Una agencia virtual.<br />Varios destinos<br />en un mismo viaje.</h2>
          <p>Nos enfocamos en viajes al exterior y propuestas multidestino. El recorrido se piensa como un conjunto: los lugares que querés conocer, el tiempo que tenés y la forma en la que te gusta viajar.</p>
        </div>
      </div>
    </section>
    <section class="agency-frame screen-frame" aria-labelledby="agency-approach-title" data-header-theme="dark" data-frame-scroll="native">
      <div class="agency-content agency-approach-content">
        <Image class="agency-landscape" src={cinqueTerre} alt="Pueblo de Manarola, en Cinque Terre, junto al mar" widths={[400, 700, 1000]} sizes="(min-width: 900px) 520px, calc(100vw - 48px)" format="webp" loading="lazy" />
        <div class="agency-approach">
          <h2 id="agency-approach-title">Cómo pensamos<br />cada recorrido</h2>
          <p>{agency.mission}</p>
        </div>
      </div>
    </section>
    <section class="agency-frame screen-frame" aria-labelledby="agency-team-title" data-header-theme="dark" data-frame-scroll="native">
      <div class="agency-content agency-team-content">
        <h2 id="agency-team-title">Detrás de la agencia</h2>
        <p class="agency-pending">{agency.history}</p>
        <div class="agency-continuation">
          <a class="button button--dark" href="/destinos/">Explorar destinos</a>
          <p>Texto provisional para revisar con la agencia.</p>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
<style>
  .agency-page { background: var(--paper); }
  .agency-frame { display: flex; align-items: center; z-index: 2; background: var(--paper); padding: calc(var(--header-height) + clamp(12px, 2.5svh, 24px)) 24px max(20px, env(safe-area-inset-bottom)); }
  .agency-content { max-width: 582px; width: 100%; margin: auto; display: flex; flex-direction: column; gap: clamp(12px, 2.8svh, 24px); }
  h1 { font-family: 'Montserrat',sans-serif; font-size: clamp(34px, 11.5vw, 45px); line-height: 1.02; font-weight: 700; letter-spacing: -1.35px; text-transform: uppercase; }
  .agency-planning { width: 100%; height: clamp(72px, calc(var(--screen-height) * .21), 220px); object-fit: cover; filter: grayscale(1); }
  .agency-introduction, .agency-approach { display: flex; flex-direction: column; gap: clamp(12px, 2svh, 18px); }
  h2 { font-family: 'Montserrat',sans-serif; font-size: clamp(21px, 6.9vw, 27px); font-weight: 500; line-height: 1.35; letter-spacing: 0; }
  p { font-size: clamp(15px, 4.1vw, 16px); line-height: 1.43; }
  .agency-landscape { width: 100%; height: clamp(120px, calc(var(--screen-height) * .3), 300px); object-fit: cover; }
  .agency-approach h2 { font-size: clamp(27px, 8vw, 31px); letter-spacing: -.93px; }
  .agency-team-content h2 { font-size: clamp(26px, 7.5vw, 29px); }
  .agency-pending { font-size: 15px; color: var(--muted); }
  .agency-continuation { display: flex; flex-direction: column; gap: 18px; padding-top: 18px; }
  .agency-continuation .button { width: 100%; }
  .agency-continuation p { font-size: 12px; color: var(--muted); }
  @media(max-height:700px) and (max-width:899px) {
    .agency-planning { height: clamp(72px, calc(var(--screen-height) * .16), 112px); }
    .agency-intro-content { gap: 12px; }
    .agency-introduction { gap: 12px; }
    .agency-introduction h2 { font-size: 21px; }
    .agency-introduction p { font-size: 15px; line-height: 1.4; }
  }
  @media(min-width:900px) {
    .agency-frame { padding: calc(var(--header-height) + 24px) 48px 32px; }
    .agency-content { max-width: 1100px; }
    .agency-intro-content { display: grid; grid-template-columns: 1fr 1fr; gap: 32px 64px; align-items: center; }
    h1 { grid-column: 1; grid-row: 1; font-size: 64px; }
    .agency-planning { grid-column: 2; grid-row: 1/3; height: clamp(240px, calc(var(--screen-height) * .55), 520px); }
    .agency-introduction { grid-column: 1; grid-row: 2; }
    .agency-approach-content { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
    .agency-landscape { height: clamp(240px, calc(var(--screen-height) * .5), 460px); }
    .agency-team-content { max-width: 680px; }
  }
</style>