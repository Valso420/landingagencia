---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import cinqueTerre from '../assets/cinque-terre.png';
import { destinations, regions } from '../data/destinations';
import { agency } from '../config/agency';
import '../styles/contact.css';
const catalogue = destinations.map(({ slug, name }) => ({ slug, name }));
const categories = regions.map(({ slug, name }) => ({ slug, name }));
const { email, phones, whatsapp, instagram } = agency.contact;
const contactPending = !email && !whatsapp && !instagram && phones.length === 0;
---
<BaseLayout title={`Contacto con la agencia · ${agency.name}`} overlayHeader>
  <div class="contact-page screen-frame" data-header-theme="light">
    <Image class="contact-editorial" data-menu-background src={cinqueTerre} alt="Cinque Terre sobre la costa de Italia" widths={[400, 800, 1200]} sizes="(min-width: 1024px) min(33.333vw, calc(50vw - 227px)), (min-width: 760px) 45vw, 100vw" format="webp" loading="eager" />
    <section class="contact-content" aria-labelledby="contact-title" data-destinations={JSON.stringify(catalogue)} data-categories={JSON.stringify(categories)}>
      <h1 id="contact-title">Consultas <br />de viaje</h1>
      <p class="contact-lead">Contanos qué viaje tenés en mente.</p>
      <h2 class="contact-channel"><span>Contacto con la agencia</span><span>Contacto de la agencia</span></h2>
      <p class="contact-destination" id="selected-destination" hidden></p>
      {email && <a class="button" href={`mailto:${email}?subject=Consulta%20de%20viaje`} data-inquiry-email>Enviar consulta por correo</a>}
      {whatsapp && <a class="button" href={whatsapp} target="_blank" rel="noopener noreferrer" data-inquiry-whatsapp>Consultar por WhatsApp <span aria-hidden="true">↗</span></a>}
      {phones.map(phone => <a class="button" href={`tel:${phone}`}>Llamar al {phone}</a>)}
      {instagram && <a class="button" href={instagram} target="_blank" rel="noopener noreferrer">Ir a Instagram <span aria-hidden="true">↗</span></a>}
      {contactPending && <>
        <button type="button" class="button" disabled aria-describedby="contact-status">Enviar consulta</button>
        <p class="contact-pending" id="contact-status">Podrás enviar tu consulta cuando la agencia confirme su canal de contacto.</p>
      </>}
      <div class="contact-back-links">
        <a id="back-destination" href="/destinos/">← Volver a destinos</a>
        <a href="/">Ir al inicio ↑</a>
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  const content = document.querySelector<HTMLElement>('.contact-content');
  const selected = document.querySelector<HTMLElement>('#selected-destination');
  const backLink = document.querySelector<HTMLAnchorElement>('#back-destination');
  if (content && selected && backLink) {
    const catalogue: { slug: string; name: string }[] = JSON.parse(content.dataset.destinations ?? '[]');
    const categories: { slug: string; name: string }[] = JSON.parse(content.dataset.categories ?? '[]');
    const parameters = new URLSearchParams(window.location.search);
    const origin = parameters.get('origen') === 'inicio' ? 'inicio' : 'destinos';
    const destination = catalogue.find(item => item.slug === parameters.get('destino'));
    const category = categories.find(item => item.slug === parameters.get('categoria'));
    const trip = destination ?? category;
    if (trip) {
      const emailLink = content.querySelector<HTMLAnchorElement>('[data-inquiry-email]');
      const whatsappLink = content.querySelector<HTMLAnchorElement>('[data-inquiry-whatsapp]');
      if (emailLink) emailLink.search = '?subject=' + encodeURIComponent(`Consulta de viaje: ${trip.name}`);
      if (whatsappLink) {
        const url = new URL(whatsappLink.href);
        if (url.hostname === 'wa.me' || url.hostname === 'api.whatsapp.com') {
          url.searchParams.set('text', `Hola, quiero consultar por un viaje a ${trip.name}.`);
          whatsappLink.href = url.href;
        }
      }
    }
    if (destination) {
      selected.textContent = `Destino de tu consulta: ${destination.name}`;
      selected.hidden = false;
      backLink.href = `/destinos/${encodeURIComponent(destination.slug)}/?origen=${origin}`;
      backLink.textContent = `← Volver a ${destination.name}`;
    } else if (category) {
      selected.textContent = `Categoría de tu consulta: ${category.name}`;
      selected.hidden = false;
      backLink.href = `${origin === 'inicio' ? '/' : '/destinos/'}#region-${encodeURIComponent(category.slug)}`;
      backLink.textContent = `← Volver a ${category.name}`;
    }
  }
</script>
