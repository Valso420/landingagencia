---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import cinqueTerre from '../assets/cinque-terre.png';
import { destinations } from '../data/destinations';
import { agency } from '../config/agency';
import '../styles/contact.css';
const catalogue = destinations.map(({ slug, name }) => ({ slug, name }));
---
<BaseLayout title={`Consultas de viaje · ${agency.name}`} overlayHeader>
  <div class="contact-page screen-frame" data-header-theme="light">
    <Image class="contact-editorial" data-menu-background src={cinqueTerre} alt="Cinque Terre sobre la costa de Italia" widths={[400, 800, 1200]} sizes="(min-width: 900px) 48vw, 100vw" format="webp" loading="eager" />
    <section class="contact-content" aria-labelledby="contact-title" data-destinations={JSON.stringify(catalogue)}>
      <h1 id="contact-title">Consultas<br />de viaje</h1>
      <p class="contact-lead">Destinos y recorridos multidestino.</p>
      <p class="contact-channel">Instagram de la agencia</p>
      {agency.contact.instagram ? <a class="button" href={agency.contact.instagram} target="_blank" rel="noopener noreferrer">Ir a Instagram <span aria-hidden="true">↗</span></a> : <p class="contact-pending" id="contact-status">[Enlace pendiente de confirmar]</p>}
      <p class="contact-destination" id="selected-destination" hidden></p>
      <div class="contact-back-links">
        <a id="back-destination" href="/destinos/">← Volver a destinos</a>
        <a href="/">Ir al inicio ↑</a>
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  const content = document.querySelector<HTMLElement>('.contact-content');
  const selected = document.querySelector<HTMLElement>('#selected-destination');
  const backLink = document.querySelector<HTMLAnchorElement>('#back-destination');
  if (content && selected && backLink) {
    const catalogue: { slug: string; name: string }[] = JSON.parse(content.dataset.destinations ?? '[]');
    const slug = new URLSearchParams(window.location.search).get('destino');
    const destination = catalogue.find(item => item.slug === slug);
    if (destination) {
      selected.textContent = `Destino de tu consulta: ${destination.name}`;
      selected.hidden = false;
      backLink.href = `/destinos/${encodeURIComponent(destination.slug)}/`;
      backLink.textContent = `← Volver a ${destination.name}`;
    }
  }
</script>
